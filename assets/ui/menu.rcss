/* The in-game menu. Sizes are in dp: the host sets 1dp = 1/720 of the window's height.
   Gradients are the vertex-colour kind (horizontal-gradient): the SDL renderer has no shaders.

   One column with a fixed space for each part, so nothing overlaps whatever the page:
     top 24 + title 53 + crumb 28 + rows 14 x 32 = 448 + note 8 + 80 (4 lines) + hint 8 + 22
     + version 4 + 18 = 693dp of 720. The longest page (a player's keys: 13 and Back) fits
     whole, so no page scrolls; a long value is cut, never drawn over its label. */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 24dp;
	color: #dfe7fb;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#040818f2 #04081850);
}

#panel {
	position: absolute;
	left: 9%;
	top: 24dp;
	width: 520dp;
}

#title {
	font-size: 46dp;
	font-weight: bold;
	font-style: italic;
	color: #ffd23f;
	height: 48dp;
	line-height: 48dp;
	padding-bottom: 2dp;
	border-bottom: 3dp #ffd23f;
}

#crumb {
	height: 24dp;
	line-height: 24dp;
	margin-bottom: 4dp;
	font-size: 18dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
	overflow: hidden;
}

#rows {
	max-height: 448dp;      /* 14 rows; a longer page would scroll, keeping the selected row in view */
	overflow-y: hidden;
}

.row {
	display: flex;
	height: 29dp;
	line-height: 29dp;
	padding: 0 16dp;
	margin-bottom: 3dp;
	font-size: 23dp;
	color: #c3cff0;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 0 auto;
	margin-right: 18dp;
}

.row .value {
	flex: 0 1 auto;
	overflow: hidden;
	color: #ffd23f;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ffd23f #ff8f1f);
	color: #0b1430;
	padding-left: 28dp;
}

.row.selected .value { color: #0b1430; }

.row .arrow { color: #8fa3d6; }
.row.selected .arrow { color: #0b1430; }

.row.info {
	height: 26dp;
	line-height: 26dp;
	font-size: 19dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #dfe7fb; }

/* a row belonging to the one above it */
.row.sub { padding-left: 40dp; font-size: 21dp; }
.row.sub .label { color: #9fb0dc; }
.row.sub.selected { padding-left: 52dp; }
.row.sub.selected .label { color: #0b1430; }

/* a line under its row: a mistake to put right (red), or how it's going (green) */
.row.error, .row.good {
	height: 24dp;
	line-height: 24dp;
	padding-left: 52dp;
	font-size: 18dp;
	color: #ff6b5a;
}
.row.good { color: #7ee08a; }

/* a section's title */
.row.heading {
	height: 24dp;
	line-height: 24dp;
	margin-top: 10dp;
	margin-bottom: 4dp;
	font-size: 16dp;
	font-weight: 700;
	color: #8fa3d6;
	letter-spacing: 1dp;
}
.row.heading:first-child { margin-top: 0; }

/* a big value to read out (a host's address) */
.row.big {
	height: 44dp;
	line-height: 44dp;
	font-size: 34dp;
	font-style: italic;
	font-weight: 700;
	color: #ffd23f;
}

#note {
	margin-top: 8dp;
	height: 80dp;           /* four lines; the help texts are written to fit */
	line-height: 20dp;
	overflow: hidden;
	font-size: 18dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint {
	margin-top: 8dp;
	height: 22dp;
	line-height: 22dp;
	font-size: 17dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
}

.key { color: #dfe7fb; }

/* the version and date, small, under the hint */
#ver {
	margin-top: 4dp;
	height: 18dp;
	line-height: 18dp;
	font-size: 15dp;
	font-weight: 500;
	color: #5f6f9c;
	white-space: nowrap;
}
