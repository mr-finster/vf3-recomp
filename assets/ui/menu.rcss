/* The in-game menu. Sizes are in dp: the host sets 1dp = 1/720 of the window's height (or 1/1280 of its width,
   if that's less: the panel is laid out for 720dp of height or more).
   Gradients are the vertex-colour kind (horizontal-gradient): the SDL renderer has no shaders.

   One column with a fixed space for each part, so nothing overlaps whatever the page:
     top 19.2 + title 42.4 + crumb 22.4 + rows 20 x 25.6 = 512 + note 6.4 + 64 (4 lines) + hint 6.4
     + 17.6 + version 3.2 + 14.4 = 708dp of 720. Every page fits whole, so none scrolls (a scroll can't be
     seen: the rows below looked missing); the longest, Display on Windows, has 19 and Back. menutest fails
     a page that doesn't fit. A long value is cut, never drawn over its label.
   (Each size 0.8 of what it was up to v0.1.18-alpha, when 14 rows fit: the same look, a size smaller, for
   Display's 20.) */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 19.2dp;
	color: #dfe7fb;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#040818f2 #04081850);
}

#panel {
	position: absolute;
	left: 9%;
	top: 19.2dp;
	width: 416dp;
}

#title {
	font-size: 36.8dp;
	font-weight: bold;
	font-style: italic;
	color: #ffd23f;
	height: 38.4dp;
	line-height: 38.4dp;
	padding-bottom: 1.6dp;
	border-bottom: 2.4dp #ffd23f;
}

#crumb {
	height: 19.2dp;
	line-height: 19.2dp;
	margin-bottom: 3.2dp;
	font-size: 14.4dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
	overflow: hidden;
}

#rows {
	max-height: 512dp;      /* 20 rows; a longer page would scroll, keeping the selected row in view */
	overflow-y: hidden;
}

.row {
	display: flex;
	height: 23.2dp;
	line-height: 23.2dp;
	padding: 0 12.8dp;
	margin-bottom: 2.4dp;
	font-size: 18.4dp;
	color: #c3cff0;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 0 auto;
	margin-right: 14.4dp;
}

.row .value {
	flex: 0 1 auto;
	overflow: hidden;
	color: #ffd23f;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ffd23f #ff8f1f);
	color: #0b1430;
	padding-left: 22.4dp;
}

.row.selected .value { color: #0b1430; }

.row .arrow { color: #8fa3d6; }
.row.selected .arrow { color: #0b1430; }

.row.info {
	height: 20.8dp;
	line-height: 20.8dp;
	font-size: 15.2dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #dfe7fb; }

/* a row belonging to the one above it */
.row.sub { padding-left: 32dp; font-size: 16.8dp; }
.row.sub .label { color: #9fb0dc; }
.row.sub.selected { padding-left: 41.6dp; }
.row.sub.selected .label { color: #0b1430; }

/* a line under its row: a mistake to put right (red), or how it's going (green) */
.row.error, .row.good {
	height: auto;
	line-height: 19.2dp;
	padding-left: 41.6dp;
	font-size: 14.4dp;
	color: #ff6b5a;
	white-space: normal;   /* (a long one, a failed join's what to do, wraps) */
}
.row.error .label, .row.good .label { flex: 1 1 auto; margin-right: 0; }
.row.good { color: #7ee08a; }

/* a section's title */
.row.heading {
	height: 19.2dp;
	line-height: 19.2dp;
	margin-top: 8dp;
	margin-bottom: 3.2dp;
	font-size: 12.8dp;
	font-weight: 700;
	color: #8fa3d6;
	letter-spacing: 0.8dp;
}
.row.heading:first-child { margin-top: 0; }

/* a big value to read out (a host's address) */
.row.big {
	height: 35.2dp;
	line-height: 35.2dp;
	font-size: 27.2dp;
	font-style: italic;
	font-weight: 700;
	color: #ffd23f;
}

#note {
	margin-top: 6.4dp;
	height: 64dp;           /* four lines; the help texts are written to fit */
	line-height: 16dp;
	overflow: hidden;
	font-size: 14.4dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint {
	margin-top: 6.4dp;
	height: 17.6dp;
	line-height: 17.6dp;
	font-size: 13.6dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
}

.key { color: #dfe7fb; }

/* the version and date, small, under the hint */
#ver {
	margin-top: 3.2dp;
	height: 14.4dp;
	line-height: 14.4dp;
	font-size: 12dp;
	font-weight: 500;
	color: #5f6f9c;
	white-space: nowrap;
}
