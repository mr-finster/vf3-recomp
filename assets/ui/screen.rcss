/* A page that's a screen of its own (the Online pages, src/host/online.cpp). Sizes in dp: 1dp = 1/720 of the
   window's height, so a 1280 x 720 window is the mock's pixels exactly. Everything in one column in the middle,
   the button hints at the bottom. Gradients are the vertex-colour kind (the SDL renderer has no shaders). */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 24dp;
	color: #d8ddf5;
	background-color: #0b1026;   /* (opaque: the game restarting under a match's end shows nothing) */
}

div { display: block; }
#screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.col {
	position: absolute;
	left: 0; right: 0; top: 40dp; bottom: 100dp;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}

.title { font-size: 58dp; line-height: 62dp; font-weight: 700; font-style: italic; color: #f2d14b; text-align: center; white-space: nowrap; }
.title.red { color: #ff7a6b; }
.sub { margin-top: 12dp; font-size: 26dp; line-height: 34dp; font-weight: 500; color: #8f9ac8; text-align: center; }
.sub.small { font-size: 22dp; line-height: 28dp; }

/* the button hints */
.foot {
	position: absolute;
	left: 0; right: 0; bottom: 40dp;
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 32dp;
	font-size: 22dp;
	font-weight: 500;
	color: #8f9ac8;
}
.hint { display: flex; align-items: center; gap: 8dp; }
.key {
	display: block;
	min-width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0 8dp;
	border-radius: 7dp;
	background-color: #d8ddf5;
	color: #0b1026;
	font-size: 17dp;
	font-weight: 600;
	text-align: center;
}

/* what's selected: the menu's yellow into orange, a white edge */
.row.selected { decorator: horizontal-gradient(#f2d14b #f0922e); color: #0b1026; border-color: #ffffff; }

/* the Online home: who's playing, the two big choices, the rest in a line under them */
.chip {
	display: flex;
	align-items: center;
	gap: 12dp;
	margin-top: 20dp;
	height: 46dp;
	padding: 0 20dp;
	border-radius: 23dp;
	border: 2dp #2a3466;
	background-color: #141b3d;
	font-size: 24dp;
}
.chip .who { color: #8f9ac8; }
.chip .me { color: #ffffff; font-size: 27dp; font-weight: 600; }
.chip.selected .who, .chip.selected .me { color: #0b1026; }
.tiles { display: flex; gap: 24dp; margin-top: 48dp; }
.tile {
	width: 300dp;
	height: 220dp;
	border-radius: 20dp;
	border: 3dp #2a3466;
	background-color: #141b3d;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: 10dp;
	color: #ffffff;
}
.tile .t { font-size: 56dp; line-height: 60dp; font-weight: 700; font-style: italic; }
.tile .s { font-size: 23dp; font-weight: 600; color: #8f9ac8; }
.tile.selected .s { color: #0b1026; }
.tile .s .live { display: inline-block; width: 12dp; height: 12dp; border-radius: 6dp; margin-right: 9dp; vertical-align: middle; background-color: #8fe08a; }
.tile.selected .s .live { background-color: #0b1026; }
.more { display: flex; align-items: center; gap: 10dp; margin-top: 40dp; font-size: 24dp; color: #8f9ac8; }
.link {
	padding: 4dp 12dp;
	border-radius: 8dp;
	color: #d8ddf5;
	border-bottom: 2dp #3a4682;
}
.link.selected { border-bottom: 2dp #ffffff; }

/* letters in boxes: a room code, a name */
.codes { display: flex; align-items: center; justify-content: center; gap: 10dp; }
.codes.name { gap: 8dp; }
.box {
	width: 88dp;
	height: 110dp;
	border-radius: 12dp;
	border: 3dp #2a3466;
	background-color: #141b3d;
	text-align: center;
	font-size: 80dp;
	line-height: 104dp;
	font-weight: 700;
	font-style: italic;
	color: #ffffff;
}
.box.set { border-color: #d8ddf5; }
.box.on { border-color: #f2d14b; }
.box.ok { border-color: #8fe08a; }
.box.big { width: 94dp; height: 112dp; font-size: 84dp; line-height: 106dp; border-color: #f2d14b; }
.box.nm { width: 68dp; height: 86dp; font-size: 60dp; line-height: 80dp; border-radius: 10dp; }
.box .caret { margin: 0 auto; margin-top: 74dp; width: 44dp; height: 6dp; border-radius: 3dp; background-color: #f2d14b; }
.box.nm .caret { margin-top: 56dp; width: 34dp; }
.box.big .caret { margin-top: 80dp; }
.dash { width: 28dp; height: 7dp; border-radius: 4dp; background-color: #8f9ac8; margin: 0 6dp; }
.dash.y { background-color: #f2d14b; }

/* a pad's letters (shown only while a pad's in use) */
.kb { display: flex; flex-direction: column; gap: 8dp; margin-top: 36dp; }
.kbrow { display: flex; gap: 8dp; justify-content: center; }
.k {
	width: 52dp;
	height: 44dp;
	line-height: 40dp;
	border-radius: 9dp;
	border: 2dp #2a3466;
	background-color: #141b3d;
	text-align: center;
	font-size: 26dp;
	font-weight: 600;
}
.kb.code .k { width: 58dp; }
.k.wide { width: 112dp; font-size: 19dp; letter-spacing: 1dp; }
.kb.code .k.wide { width: 124dp; }
.k.ok { color: #f2d14b; font-size: 19dp; }
.k.selected { border-color: #ffffff; }

.typed { margin-top: 44dp; display: flex; flex-direction: column; align-items: center; gap: 12dp; font-size: 27dp; color: #d8ddf5; }
.typed .line { display: flex; align-items: center; gap: 10dp; }
.typed .small { font-size: 22dp; color: #8f9ac8; }
.problem { margin-top: 18dp; font-size: 24dp; color: #ff7a6b; text-align: center; }

/* the steps, left to right: rings joined by lines, a label centred under each (the one on now: a ring with a dot in it;
   done: filled, a tick; failed: filled, a cross) */
.stepsat { margin-top: 40dp; }
.steps { display: flex; align-items: flex-start; width: 720dp; height: 90dp; }
.st { position: relative; width: 46dp; height: 46dp; }
.st .dot {
	box-sizing: border-box;
	width: 46dp;
	height: 46dp;
	border-radius: 23dp;
	border: 3dp #3a4682;
}
.st .lbl {
	position: absolute;
	left: -57dp; top: 62dp;
	width: 160dp;
	text-align: center;
	font-size: 20dp;
	line-height: 24dp;
	font-weight: 600;
	letter-spacing: 1.5dp;
	color: #5d6799;
	white-space: nowrap;
}
.st.done .dot { border-color: #8fe08a; background-color: #8fe08a; }
.st.done .dot img { display: block; margin: 8dp auto 0 auto; width: 24dp; height: 24dp; }
.st.done .lbl { color: #8fe08a; }
.st.now .dot { border-color: #f2d14b; }
.st.now .pip { width: 14dp; height: 14dp; border-radius: 7dp; margin: 13dp auto 0 auto; background-color: #f2d14b; }
.st.now .lbl { color: #ffffff; }
.st.bad .dot { border-color: #ff7a6b; background-color: #ff7a6b; color: #0b1026; text-align: center; font-size: 30dp; line-height: 40dp; font-weight: 600; }
.st.bad .lbl { color: #ff7a6b; }
.ln { flex: 1; height: 4dp; margin-top: 21dp; margin-left: 10dp; margin-right: 10dp; border-radius: 2dp; background-color: #3a4682; }
.ln.done { background-color: #8fe08a; }

.status { margin-top: 28dp; font-size: 28dp; line-height: 38dp; font-weight: 600; color: #ffffff; text-align: center; }
.status.good { color: #8fe08a; }
.status.bad { color: #ff7a6b; }
.status .why { display: block; font-size: 23dp; line-height: 31dp; font-weight: 500; color: #8f9ac8; }
.status.plain { font-size: 26dp; line-height: 34dp; font-weight: 500; color: #d8ddf5; max-width: 860dp; }

.btns { display: flex; gap: 20dp; margin-top: 30dp; }
.btn {
	width: 260dp;
	height: 68dp;
	line-height: 62dp;
	border-radius: 12dp;
	border: 3dp #2a3466;
	background-color: #141b3d;
	text-align: center;
	font-size: 30dp;
	font-weight: 700;
	font-style: italic;
	color: #ffffff;
}
.note { margin-top: 16dp; font-size: 22dp; line-height: 28dp; font-weight: 500; color: #8f9ac8; text-align: center; }
.note.good { color: #8fe08a; }

/* after a match: the two names, and three numbers */
.mini { display: flex; align-items: center; gap: 22dp; margin-top: 22dp; }
.mini .n { font-size: 44dp; line-height: 48dp; font-weight: 700; font-style: italic; color: #ffffff; }
.mini .n.me { color: #f2d14b; }
.mini .vs {
	box-sizing: border-box;   /* (58 across with its border: the line its height inside it, VS in the middle) */
	width: 58dp;
	height: 58dp;
	border-radius: 29dp;
	border: 3dp #ffffff;
	padding-right: 3dp;
	text-align: center;
	font-size: 28dp;
	line-height: 50dp;   /* (52 inside the border; Barlow's capitals sit a dp low in their line) */
	font-weight: 700;
	font-style: italic;
	color: #ffffff;
}
.mini .score { font-size: 56dp; line-height: 60dp; font-weight: 700; font-style: italic; color: #ffffff; padding: 0 10dp; }
.stats { display: flex; gap: 16dp; margin-top: 34dp; }
.stat {
	width: 200dp;
	padding: 14dp 0;
	border-radius: 14dp;
	border: 2dp #2a3466;
	background-color: #141b3d;
	text-align: center;
}
.stat .v { font-size: 40dp; line-height: 44dp; font-weight: 700; color: #ffffff; }
.stat .v.good { color: #8fe08a; }
.stat .v.relay { color: #f2d14b; }
.stat .l { font-size: 19dp; letter-spacing: 2dp; color: #8f9ac8; font-weight: 600; }

/* a host's address, read out (by address) */
.address { margin-top: 36dp; font-size: 84dp; line-height: 90dp; font-weight: 700; font-style: italic; color: #ffffff; }
.flag { width: 32dp; height: 24dp; margin: 0 10dp; border: 1dp #ffffff55; vertical-align: middle; }
.mini .flag { width: 40dp; height: 30dp; }
.chip .flag { width: 28dp; height: 21dp; margin: 0; }


/* The room browser (the Online screen): a header that stays (the title, the name, the actions, the filters), the list
   between it and the hints, a row a room in columns, a window of them scrolled to the selection, its place at the right */
.bhead { position: absolute; left: 56dp; right: 56dp; top: 22dp; height: 54dp; display: flex; align-items: center; gap: 18dp; }
.btitle { font-size: 48dp; line-height: 52dp; font-weight: 700; font-style: italic; color: #f2d14b; }
.bgame { font-size: 21dp; color: #8f9ac8; }
.chip.bchip { margin-top: 0; margin-left: auto; height: 40dp; font-size: 21dp; }
.bacts { position: absolute; left: 56dp; right: 56dp; top: 88dp; display: flex; gap: 10dp; }
.ab { height: 42dp; line-height: 38dp; padding: 0 16dp; border-radius: 10dp; border: 2dp #2a3466; background-color: #141b3d; font-size: 21dp; font-weight: 700; font-style: italic; color: #ffffff; }
.ab .abs { font-style: normal; font-weight: 500; font-size: 18dp; color: #8f9ac8; margin-left: 8dp; }
.ab.selected .abs { color: #0b1026; }
.ab .live { display: inline-block; width: 9dp; height: 9dp; border-radius: 5dp; margin-right: 5dp; background-color: #8fe08a; }
.abgap { flex: 1; }
.bfilt { position: absolute; left: 56dp; right: 56dp; top: 146dp; height: 40dp; display: flex; align-items: center; gap: 8dp; font-size: 20dp; color: #8f9ac8; }
.bfl { margin-left: 10dp; }
.bf { padding: 0 14dp; height: 30dp; line-height: 26dp; border-radius: 10dp; border: 2dp #2a3466; color: #d8ddf5; }
.bf.on { background-color: #d8ddf5; color: #0b1026; border-color: #d8ddf5; }
.bf.sort { margin-left: 14dp; }
.bcount { margin-left: auto; color: #8f9ac8; }
.bcount .bnewc { color: #8fe08a; margin-left: 10dp; }   /* (rooms new since the list was scrolled from its top: up there) */
.blist { position: absolute; left: 56dp; right: 70dp; top: 194dp; bottom: 98dp; border-top: 2dp #2a3466; }
.bcols, .brow { display: flex; align-items: center; padding: 0 12dp; }
.bcols { height: 28dp; font-size: 14dp; letter-spacing: 1.5dp; color: #8f9ac8; border-bottom: 2dp #2a3466; }
.brow { height: 36dp; font-size: 20dp; color: #d8ddf5; border-bottom: 1dp #1d2654; }
.brow.selected { border-radius: 8dp; border: 2dp #ffffff; }
/* (each column its own width and well clear of the next; the count right-aligned in its own) */
.c1 { width: 240dp; padding-right: 24dp; } .c2 { width: 200dp; padding-right: 24dp; } .c3 { flex: 1; padding-right: 24dp; }
.c5 { width: 110dp; text-align: right; padding-right: 40dp; } .c7 { width: 84dp; text-align: right; font-weight: 700; font-style: italic; }
.c1, .c2, .c5, .c7 { box-sizing: content-box; flex: none; }
.brow .c3 .pn { display: inline-block; width: 150dp; white-space: nowrap; overflow: hidden; vertical-align: top; }
.brow .c3 .pn .flag.s { margin-right: 7dp; }
.qm { font-size: 15dp; font-weight: 600; letter-spacing: 1.5dp; padding: 1dp 8dp; border: 1dp #3a4682; border-radius: 4dp; color: #8f9ac8; }
.brow.selected .qm { color: #0b1026; border-color: #0b1026; }
.nohost { color: #3a4682; }
.brow .c3 .pn + .sc + .pn { text-align: left; }
.ab.abmore { padding: 0 14dp; font-style: normal; font-weight: 600; color: #8f9ac8; }
.ab.abmore.selected { color: #0b1026; }
.bnote { position: absolute; left: 56dp; right: 56dp; bottom: 74dp; height: 22dp; font-size: 19dp; font-weight: 500; color: #8f9ac8; text-align: center; }
.fr2 { margin-left: 24dp; }
.brow .c1 { color: #ffffff; white-space: nowrap; overflow: hidden; }
.brow .c2, .brow .c3 { white-space: nowrap; overflow: hidden; }
.brow .c3, .brow .c5, .brow .c7 { color: #8f9ac8; }
.brow .c3 .wt { color: #d8ddf5; }   /* (Open: a hollow ring, as the site's; a match on, the green dot) */
/* (a match on: a green disc; open: a ring. The mono font's own circles: round at any size, on any renderer) */
.brow .mark { display: inline-block; width: 18dp; font-family: "JetBrains Mono"; font-size: 15dp; color: #8fe08a; vertical-align: top; padding-top: 4dp; }
.brow .mark.open { color: #8f9ac8; }
.brow.selected .mark { color: #0b1026; }
.brow .c3 .sc { display: inline-block; width: 52dp; text-align: center; color: #f2d14b; font-weight: 700; font-style: italic; vertical-align: top; }   /* (the score in a slot of its own; its baseline the names') */
.brow.selected .c1, .brow.selected .c2, .brow.selected .c3, .brow.selected .c3 .wt, .brow.selected .c3 .sc, .brow.selected .c5, .brow.selected .c7 { color: #0b1026; }
.flag.s { width: 26dp; height: 19dp; margin: 0 8dp 0 0; }
.bicon { position: relative; width: 52dp; height: 40dp; margin: 72dp auto 0 auto; border: 3dp #3a4682; border-radius: 6dp; }   /* (an empty list: the page's own line drawing of one) */
.bicon div { position: absolute; left: 8dp; right: 8dp; height: 3dp; border-radius: 2dp; background-color: #3a4682; }
.bicon.bad { border-color: #ff7a6b; } .bicon.bad div { background-color: #ff7a6b; }
.bempty { margin-top: 16dp; font-size: 26dp; color: #d8ddf5; text-align: center; }
.bempty.bad { color: #ff7a6b; }
.bempty2 { margin-top: 10dp; font-size: 22dp; color: #8f9ac8; text-align: center; }
.bsb { position: absolute; right: 44dp; width: 6dp; border-radius: 3dp; background-color: #1d2654; }
.bsbt { position: absolute; right: 44dp; width: 6dp; border-radius: 3dp; background-color: #8f9ac8; }
.bproblem { position: absolute; left: 0; right: 0; bottom: 100dp; text-align: center; font-size: 22dp; color: #ff7a6b; }

/* Create room: a form, a row a choice */
.form { width: 820dp; margin-top: 24dp; }
.fr { display: flex; align-items: center; height: 56dp; padding: 0 22dp; border-bottom: 2dp #2a3466; font-size: 25dp; }
.fr.selected { border-radius: 10dp; border: 3dp #ffffff; }
.fl { width: 250dp; color: #8f9ac8; }
.fv { color: #ffffff; }
.fs { color: #8f9ac8; font-size: 20dp; }
.fbox { padding: 0 10dp; border: 2dp #3a4682; border-radius: 6dp; }
.fr.selected .fl, .fr.selected .fv, .fr.selected .fs { color: #0b1026; }
.roomname { margin-top: 40dp; font-size: 64dp; line-height: 72dp; font-weight: 700; font-style: italic; color: #ffffff; border-bottom: 3dp #f2d14b; min-width: 300dp; text-align: center; }
.roomname .caret { display: inline-block; width: 4dp; height: 56dp; margin-left: 6dp; background-color: #f2d14b; }

/* a room's own page: who plays, who watches, who's next */
.panes { display: flex; gap: 24dp; margin-top: 28dp; }
.pane { width: 480dp; padding: 16dp 22dp; border-radius: 14dp; border: 2dp #2a3466; background-color: #141b3d; }
.ph { font-size: 17dp; letter-spacing: 2dp; color: #8f9ac8; margin: 6dp 0; }
.pvs { font-size: 32dp; font-weight: 700; font-style: italic; color: #ffffff; }
.pvs .psc { color: #f2d14b; margin: 0 14dp; }
.pq { font-size: 23dp; color: #d8ddf5; }
.flag.s.hb { margin: 0 8dp 0 8dp; }
.note.quiet { margin-top: 20dp; font-size: 19dp; line-height: 24dp; }   /* (a line beside the point: Quick match can be watched) */
